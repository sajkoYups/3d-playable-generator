DATABASE_URL="postgresql://playable:playable@localhost:5433/playable_3d?schema=public"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PLATFORM_ADMIN_EMAILS="you@example.com"

# Optional: password-reset emails via Resend. Without these, reset links are logged to the server console.
RESEND_API_KEY=
AUTH_EMAIL_FROM="ForgePlay <noreply@example.com>"

# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# S3 / Cloudflare R2 (when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION="auto"
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
